// fibonacci.lox — recursión pura con llamadas a función.
// Ejercita la creación de cuadros de llamada, el entorno de cada closure y
// la resolución estática de referencias. Portable: no usa %, clases.

fun fib(n) {
  if (n < 2) {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}

var total = 0;
var i = 0;
while (i < 21) {
  total = total + fib(i);
  i = i + 1;
}
print total;
